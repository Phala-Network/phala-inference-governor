+            for reasoning_limit in (None, 1, 2, 64, 256, 4096, 8192):
+                with self.subTest(output=output_limit, reasoning=reasoning_limit):
+                    bounds = self.chat._qwen35_reasoning_effort_token_range(
+                        "medium", output_limit, reasoning_limit
