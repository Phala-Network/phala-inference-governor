+    def visit(node: Any) -> None:
+        if isinstance(node, dict):
+            if node.get("type") == "tags_with_separator":
+                repetitions.append(node)
+            for child in node.values():
+                visit(child)
+        elif isinstance(node, list):
+            for child in node:
