+        raise ValueError(
+            "Qwen3 Coder required structural tag must contain one repeated-tag format"
+        )
+
+    repetitions[0]["separator"] = "\n"
+    repetitions[0]["stop_after_first"] = not parallel_tool_calls
+    return StructuralTag.model_validate(value)
 
 
